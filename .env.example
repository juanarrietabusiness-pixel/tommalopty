# =============================================================================
#  Plantilla de variables de entorno — copiar a .env.local en cada app
#  NUNCA commitear valores reales. Un archivo por entorno: dev / staging / prod.
# =============================================================================

# --- Sitio ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_BRAND_NAME=Nébula Store
NEXT_PUBLIC_CURRENCY=USD

# --- Supabase -------------------------------------------------------------
# URL y anon key son públicas (protegidas por RLS). La service-role key NO:
# solo se usa en servidor (Route Handlers / Server Actions del panel admin).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Pasarelas de pago ----------------------------------------------------
# Stripe NO opera con comercios domiciliados en Panamá; ver docs/PAGOS-PANAMA.md
PAYMENTS_ENABLED_PROVIDERS=paypal,wompi

# PayPal Checkout (cobertura internacional)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Wompi (Banistmo) — tarjetas locales
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# PagueloFacil — tarjetas + Clave
PAGUELOFACIL_ENV=sandbox
PAGUELOFACIL_CCLW=
PAGUELOFACIL_ACCESS_TOKEN=

# Yappy (Banco General) — pago por QR
YAPPY_ENV=sandbox
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=

# --- Meta (Pixel + Conversions API) ---------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# --- Analytics ------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Email transaccional (Resend) -----------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Nébula Store <hola@tudominio.com>"
EMAIL_REPLY_TO=hola@tudominio.com

# --- Almacenamiento de media (Cloudflare R2) ------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nebula-media
NEXT_PUBLIC_R2_PUBLIC_URL=
