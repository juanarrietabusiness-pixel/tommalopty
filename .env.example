# =============================================================================
#  Plantilla de variables de entorno — copiar a .env.local en cada app
#  NUNCA commitear valores reales. Un archivo por entorno: dev / staging / prod.
# =============================================================================

# --- Sitio ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_BRAND_NAME=Nébula Store
NEXT_PUBLIC_CURRENCY=USD

# --- Supabase -------------------------------------------------------------
# URL y anon key son públicas (protegidas por RLS). La service-role key NO:
# solo se usa en servidor (Route Handlers / Server Actions del panel admin).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Pasarelas de pago ----------------------------------------------------
# Stripe NO opera con comercios domiciliados en Panamá; ver docs/PAGOS-PANAMA.md
PAYMENTS_ENABLED_PROVIDERS=paypal,wompi

# PayPal Checkout (cobertura internacional)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Wompi (Banistmo) — tarjetas locales
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# PagueloFacil — tarjetas + Clave
PAGUELOFACIL_ENV=sandbox
PAGUELOFACIL_CCLW=
PAGUELOFACIL_ACCESS_TOKEN=

# Yappy (Banco General). OJO: son DOS productos distintos con el mismo nombre.
#
# 1) Botón de Pago — cobrar en el checkout. El «Pagar con Yappy» que manda al
#    comprador a su app. Credenciales del portal: ID de comercio, clave secreta
#    y el dominio declarado ahí. Sin las tres, el checkout no ofrece Yappy.
YAPPY_ENV=sandbox
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=
YAPPY_DOMAIN_URL=

# 2) Integración Core / «Apificación» de Yappy Comercial — NO cobra: lee los
#    movimientos ya cobrados para conciliarlos con los pedidos. Credenciales de
#    Yappy Comercial → Integraciones → Generar credenciales.
#
#    YAPPY_API_URL no sale de la documentación: la especificación trae
#    `http://localhost:3000` como marcador de posición, y el host real lo da
#    Yappy al habilitar el comercio. Sin él no se puede llamar a nada.
#
#    Para comprobar que las tres sirven, antes de tocar la tienda:
#      pnpm --filter @nebula/integrations yappy:validar
YAPPY_API_URL=
YAPPY_API_KEY=
YAPPY_API_SECRET_KEY=

# --- Meta (Pixel + Conversions API) ---------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# --- Analytics ------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Versión de la API de Meta. Solo se toca si Meta retira la que se usa por
# omisión; el código trae una puesta.
META_API_VERSION=

# --- Mapa --------------------------------------------------------------------
# El proveedor de las teselas del checkout y de la pantalla de despacho.
#
# Faltaba aquí, y es el P1 número 4: hoy se usa CARTO sin clave, y su cuota
# razonable no cubre una tienda abierta al público. Quien contrate un plan lo
# cambia con esta variable y nada más — el componente ya la lee.
#
# Plantilla con {z}/{x}/{y}. Si el proveedor pide clave, va dentro de la URL.
# Sin definirla, se usa CARTO.
NEXT_PUBLIC_MAP_TILES_URL=
# La atribución que exige la licencia del proveedor. Cambiar de proveedor sin
# cambiar esto deja acreditado a quien ya no pone las imágenes.
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Email transaccional (Resend) -----------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Nébula Store <hola@tudominio.com>"
EMAIL_REPLY_TO=hola@tudominio.com

# --- Almacenamiento de media (Cloudflare R2) ------------------------------
# El panel escribe en R2 por el *binding* `MEDIA` declarado en
# apps/admin/wrangler.jsonc, no por la API S3: no hacen falta credenciales, y
# por eso aquí no hay ninguna clave. Ver docs/adr/0007-media-en-cloudflare.md
#
# Lo único que sí hace falta es desde qué dominio se sirven las imágenes ya
# subidas. Sin esto el panel se niega a subir, en vez de guardar un objeto cuya
# URL nadie puede componer:
#   - mientras no haya dominio propio, la URL pública r2.dev del bucket. Es la
#     que está puesta abajo. Cloudflare la limita por tasa y no la recomienda
#     para producción: sirve para desarrollo y para enseñar la plataforma.
#   - en producción, un dominio propio conectado al bucket (p. ej.
#     https://media.tudominio.com). Cambiar esto NO mueve las imágenes ya
#     subidas: las claves son las mismas, solo cambia el dominio que las sirve.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-524ecdb67a9a4230b194ae8a7de615e3.r2.dev

# --- Bóveda de credenciales -------------------------------------------------
# La única variable que hace falta para que las demás dejen de hacer falta.
#
# Con ella puesta, las credenciales de Yappy, Meta, Resend y las pasarelas se
# pegan desde el panel (Integraciones) y se guardan cifradas en la base. Sin
# ella, todo sigue funcionando por variables de entorno como hasta ahora.
#
# No puede vivir en la base de datos: guardar la llave encima del cofre no es
# cifrar. Es el mismo compromiso que hace n8n con N8N_ENCRYPTION_KEY.
#
# Se genera con 32 bytes aleatorios en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Si se pierde, los secretos guardados no se recuperan: se vuelven a pegar.
# Si se cambia, lo mismo. Guárdala donde guardes las contraseñas del negocio.
CREDENCIALES_CLAVE_MAESTRA=
